# Server-only secrets. Never use NEXT_PUBLIC_ for these.
# Any OpenAI-compatible provider works. The key below is sent as a Bearer token.
# OpenRouter: https://openrouter.ai/api/v1   |   Groq: https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
# Optional public site URL sent to OpenRouter as HTTP-Referer.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Optional model IDs; these are Groq model IDs; verify in your provider's model list.
MODEL_GENERAL=openai/gpt-oss-120b
MODEL_CODING=openai/gpt-oss-120b
MODEL_FAST=openai/gpt-oss-20b

# Firebase Web app config (these are public client config values, protected by Firebase rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account JSON as one-line JSON; optional for local demo,
# required for authenticated server endpoints in production.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Isolated command sandbox. Keep secret server-side.
E2B_API_KEY=

# Email sign-in codes (6 digits). Needs a Firestore database in the Firebase project
# and a Resend account (https://resend.com). Without a verified domain Resend only
# delivers to your own account email.
RESEND_API_KEY=
EMAIL_FROM=Leo AI <onboarding@resend.dev>
