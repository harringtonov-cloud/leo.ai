# Server-only secrets. Never use NEXT_PUBLIC_ for these.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional model IDs; verify availability/pricing in OpenRouter.
MODEL_GENERAL=anthropic/claude-sonnet-4
MODEL_CODING=anthropic/claude-sonnet-4
MODEL_FAST=openai/gpt-4.1-mini

# Firebase Web app config (these are public client config values, protected by Firebase rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account JSON as one-line JSON; optional for local demo,
# required for authenticated server endpoints in production.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Isolated command sandbox. Keep secret server-side.
E2B_API_KEY=
